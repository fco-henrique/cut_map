# Servidor
PORT=3000

# PostgreSQL local
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=substitua_pela_senha_local
DATABASE_DATABASE=cut_map
DATABASE_AUTOLOADENTITIES=true
# Apenas para desenvolvimento local. Use migrações ao desativar a sincronização.
DATABASE_SYNCHRONIZE=true

# Use valores longos e diferentes para cada segredo.
JWT_SECRET=substitua_por_um_segredo_longo
JWT_REFRESH_SECRET=substitua_por_outro_segredo_longo
JWT_RESET_SECRET=substitua_por_um_terceiro_segredo_longo
JWT_TOKEN_AUDIENCE=cut-map
JWT_TOKEN_ISSUER=cut-map-api
JWT_TTL=3600

# SMTP necessário para verificação de e-mail e recuperação de senha.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=conta@example.com
MAIL_PASS=substitua_pela_senha_smtp
